<?xml version="1.0" encoding="utf-8"?>
<!-- 2×1 cells by default, resizable. updatePeriodMillis is only a safety
     net (the widget sets its own alarms, see SunWidget.kt). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/sun_widget"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="80dp"
    android:minWidth="110dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/sun_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="2"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen" />
